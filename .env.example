# URL pública (sin barra final)
NEXT_PUBLIC_SITE_URL=https://nir.amoxtli.tech

# Firebase (navegador) — Configuración del proyecto > Tus apps > Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nir-app-26fa6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nir-app-26fa6
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor). JSON de la cuenta de servicio en base64:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# WhatsApp de ventas para "Pide tu kit Nir" (formato internacional, sin +)
NEXT_PUBLIC_SALES_WHATSAPP=5215500000000

# Secreto compartido con GitHub Actions para las rutas /api/cron/*
CRON_SECRET=

# Desarrollo local con Firebase Emulator Suite (npm run emulators)
NEXT_PUBLIC_USE_EMULATORS=false
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
