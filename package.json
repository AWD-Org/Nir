{
  "name": "nir",
  "version": "0.1.0",
  "private": true,
  "description": "AMOXTLI Nir — tarjetas NFC/QR por mesa con página tipo Linktree, carta digital y admin para el dueño",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nir-rules \"vitest run tests/rules\"",
    "emulators": "firebase emulators:start --project demo-nir",
    "seed": "tsx scripts/seed-demo.mts",
    "set-role": "tsx scripts/set-role.mts",
    "backup": "tsx scripts/backup.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "next": "^15.5.29",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.34.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
